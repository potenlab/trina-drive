# AppArmor profile for the shelf container: Docker's own docker-default profile (moby/profiles apparmor v0.1.0, as
# shipped with Docker 29) plus the three things bubblewrap needs to build a worker sandbox inside the container:
#   userns      create a user namespace (Ubuntu 23.10+ restricts this for unconfined and unlisted programs)
#   mount       mount inside that namespace (the kernel still refuses mounts in the container's own namespace:
#   pivot_root  the container has no capabilities there)
# Everything else is unchanged from docker-default. Load it once on the Docker host (it is not persistent unless you
# also copy it to /etc/apparmor.d/):
#   sudo apparmor_parser -r docker/apparmor-shelf-bwrap
# and use it with:  security_opt: [ "apparmor=shelf-bwrap" ]   (docs/DOCKER.md, "Security settings")
# AppArmor 3 hosts (Debian 12, Ubuntu 22.04): delete the `abi` line and the `userns,` rule; those kernels do not
# restrict user namespaces through AppArmor.
abi <abi/4.0>,
include <tunables/global>

profile shelf-bwrap flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # --- added for bubblewrap (the only differences from docker-default) ---
  userns,
  mount,
  pivot_root,
  # ---

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=shelf-bwrap,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=shelf-bwrap,
}
