# Copy outside the repository (README, Deploy step 1): cp terraform.tfvars.example ~/.config/trina-drive/tdcloud-tf/terraform.tfvars
region     = "ap-northeast-2"
domain     = "cloud.trina.app"
acme_email = "contact@trina.app"
# mail_domain = ""                 # empty = domain: SES DKIM/DMARC records go into the Route 53 zone
host_max   = 3                     # the scaler runs 0..host_max hosts (README, "Hosts: scale-out and scale-in")
# host_instance_type = "m7g.large"   # 10 slots; m7g.xlarge = 20
# host_data_gb       = 100           # gp3, grows online
# office_cidrs       = ["203.0.113.7/32"]   # the office NAT: higher rate limits (caddy/team_routes.caddy)
trina_image_tag   = "0.3.0-<commit>" # tags are immutable: a new tag per build
control_image_tag = "0.2.0-<commit>"
caddy_image_tag   = "2.10.2-2"           # 2.10.2-2: the /dav/* body exception and office zones
# a deploy identity without kms:PutKeyPolicy / iam:TagRole (README, Deploy step 0):
# kms_admin_arns                         = ["arn:aws:iam::<account>:user/tdcloud-deploy"]
# create_autoscaling_service_linked_role = false
# mail_upstream = "resend"         # resend (default) | ses | smtp; the key: SSM /tdcloud/{control,hosts}/resend-api-key
# resend_domain = "drive.trina.app" # verified in Resend (Tokyo); DNS at Cloudflare (cloud/scripts/resend-domain.ts)
