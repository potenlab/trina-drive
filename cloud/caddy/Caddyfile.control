# Trina Cloud — Caddy on the control host: https://<domain> (sign-up, dashboard, Paddle webhook) → the control plane on
# 127.0.0.1:8790. /internal/* is reachable only over the VPC (the hosts' Caddy calls it directly), never through here.
#   TDCLOUD_DOMAIN, ACME_EMAIL
{
	email {$ACME_EMAIL}
	admin localhost:2019
	order rate_limit before reverse_proxy
	servers {
		# the client's address ({client_ip}: rate-limit keys, X-Forwarded-For to the team). Nothing sits in front of
		# Caddy today (DNS points at the host's Elastic IP), so TDCLOUD_FRONT_PROXIES is empty and {client_ip} is the TCP
		# peer. With a load balancer or CDN in front, list its ranges there (README, "Client addresses").
		trusted_proxies static {$TDCLOUD_FRONT_PROXIES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		strict_sni_host on
	}
	log {
		output stdout
		format json
	}
}

{$TDCLOUD_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 2MB
	}
	respond /internal/* 404
	rate_limit {
		zone all {
			key {client_ip}
			events 300
			window 1m
		}
	}
	# X-Forwarded-For = the client's address only (never one the client sent); the control plane believes it only from
	# this peer (TDCLOUD_TRUSTED_PROXIES=127.0.0.1)
	reverse_proxy 127.0.0.1:8790 {
		header_up X-Forwarded-For {client_ip}
	}
}
