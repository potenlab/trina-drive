# Trina Cloud — Caddy on the control host: https://<domain> (sign-up, dashboard, Paddle webhook) → the control plane on
# 127.0.0.1:8790. /internal/* is reachable only over the VPC (the hosts' Caddy calls it directly), never through here.
#   TDCLOUD_DOMAIN, ACME_EMAIL
{
	email {$ACME_EMAIL}
	admin localhost:2019
	order rate_limit before reverse_proxy
	servers {
		strict_sni_host on
	}
	log {
		output stdout
		format json
	}
}

{$TDCLOUD_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 2MB
	}
	respond /internal/* 404
	rate_limit {
		zone all {
			key {remote_host}
			events 300
			window 1m
		}
	}
	# Caddy sets X-Forwarded-For to the client's address (it does not pass on one the client sent); the control plane
	# believes it only from this peer (TDCLOUD_TRUSTED_PROXIES=127.0.0.1)
	reverse_proxy 127.0.0.1:8790
}
