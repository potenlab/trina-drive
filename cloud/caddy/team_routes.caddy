# The routes in front of every team (imported by Caddyfile and Caddyfile.dev).
(team_routes) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	request_body {
		max_size 25MB
	}
	# per client address ({client_ip}: the TCP peer, or what a trusted front proxy says; see the global options)
	rate_limit {
		zone signin {
			match {
				path /api/login /api/login/second /api/setup /api/links/* /api/me/reauth /oauth/token /oauth/register /oauth/authorize
			}
			key {client_ip}
			events 30
			window 1m
		}
		zone mcp {
			match {
				path /mcp
			}
			key {client_ip}
			events 300
			window 1m
		}
		zone all {
			key {client_ip}
			events 1200
			window 1m
		}
	}
	# /health is for the host itself (Docker's HEALTHCHECK runs inside the container)
	respond /health 404
	reverse_proxy tdc-{labels.{$TDCLOUD_SLUG_LABEL}}:8787 {
		# exactly one address, the client's, whatever the client sent: the team believes this header from Caddy's fixed
		# address only (TDRIVE_TRUSTED_PROXY), so its sign-in / MCP limits and audit addresses are per client
		header_up X-Forwarded-For {client_ip}
		transport http {
			dial_timeout 3s
			response_header_timeout 60s
		}
	}
	handle_errors 502 503 504 {
		rewrite * /paused.html
		file_server {
			root /srv
		}
		header Cache-Control no-store
	}
}
