{
  "name": "shelf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Permission-aware read shell and draft box for AI agents over existing team folders (phase-0 prototype)",
  "license": "UNLICENSED",
  "scripts": {
    "test": "bun test",
    "test:fuzz": "bun run test/security/fuzz.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "cli": "bun run src/cli.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "bin": {
    "shelf": "src/cli.ts"
  }
}
