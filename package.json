{
  "name": "trina-drive",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Trina Drive: a self-hosted, permission-aware team file server for AI agents. Agents see only what each person may see, never touch originals, and every read is logged.",
  "license": "Apache-2.0",
  "homepage": "https://drive.trina.app",
  "repository": { "type": "git", "url": "https://github.com/potenlab/trina-drive.git" },
  "scripts": {
    "test": "bun test --timeout 30000",
    "test:fuzz": "bun run test/security/fuzz.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "cli": "bun run src/cli.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "brand:sync": "bun scripts/sync-brand.ts",
    "brand:check": "bun scripts/sync-brand.ts --check"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "bin": {
    "tdrive": "src/cli.ts"
  }
}
