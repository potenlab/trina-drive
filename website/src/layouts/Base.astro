---
import '../styles/global.css'
import type { Copy } from '../content/en'
import { SITE_URL } from '../site'

interface Props {
  t: Copy
  title?: string
  description?: string
  noindex?: boolean
  jsonLd?: object
  /** Landing page: preload the hero's display font. */
  preloadHero?: boolean
  /** Canonical URL to emit even on a noindex page (A/B variants point at the original). */
  canonicalHref?: string
  /** Home-page A/B variant; turns on the A/B measurement script. */
  variant?: 'a' | 'b'
}
const { t, title = t.meta.title, description = t.meta.description, noindex = false, jsonLd, preloadHero = false, canonicalHref, variant } = Astro.props
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/')
const canonical = canonicalHref ?? new URL(path, SITE_URL).href
const ogImage = new URL(t.meta.ogImage, SITE_URL).href
---
<!doctype html>
<html lang={t.lang} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {(!noindex || canonicalHref) && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#fcfbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0c0b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    {preloadHero && <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trina Drive" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Applies a saved light/dark choice before first paint. External file: the CSP allows no inline script. -->
    <script is:inline src="/theme.js"></script>
    <script is:inline defer src="/ab.js"></script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
