---
// One compact comparison used by both variants: an ontology/RAG build vs. a drive connector vs. Trina Drive (last
// column, highlighted), with a small demo beside it (passed in as the default slot). On phones each row becomes a
// label over three cells.
import Icon from './Icon.astro'
interface Props {
  /** Tinted background (default) or plain, to keep the section rhythm of the page using it. */
  tint?: boolean
  c: { eyebrow: string; title: string; sub: string; cols: string[]; rows: { label: string; cells: string[] }[]; demoLabel: string; types?: string[] }
}
const { c, tint = true } = Astro.props
const last = c.cols.length - 1
---
<section class={`section${tint ? ' section-tint' : ''}`} id="compare" aria-labelledby="cmp-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{c.eyebrow}</span>
      <h2 id="cmp-title">{c.title}</h2>
      <p>{c.sub}</p>
    </div>
    <div class="cmp" data-reveal>
      <table class="cmp-table">
        <thead>
          <tr>
            <td></td>
            {c.cols.map((col, i) => <th scope="col" class={i === last ? 'cmp-us' : ''}>{col}</th>)}
          </tr>
        </thead>
        <tbody>
          {c.rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {r.cells.map((cell, i) => (
                <td class={i === last ? 'cmp-us' : ''}><Icon name={i === last ? 'check' : 'minus'} /><span>{cell}</span></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <figure class="cmp-demo" aria-hidden="true">
        <figcaption class="cmp-demo-label"><Icon name="search" />{c.demoLabel}</figcaption>
        <slot />
        {c.types && <div class="cmp-types">{c.types.map((x) => <span>{x}</span>)}</div>}
      </figure>
    </div>
  </div>
</section>
