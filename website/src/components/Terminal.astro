---
// Hero demo. The full transcript is in the HTML (works without JS and for screen readers via the sr-only copy);
// src/scripts/main.ts replays it line by line unless the visitor prefers reduced motion.
import type { Copy } from '../content/en'
interface Props { t: Copy }
const { t } = Astro.props
const tm = t.terminal
const prompt = (who: 'kim' | 'boss') => `${who} $ `
---
<figure class="term" data-term aria-labelledby="term-label">
  <figcaption id="term-label" class="sr-only">{tm.label}</figcaption>
  <div class="term-bar">
    <div class="term-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="term-tabs" aria-hidden="true">
      <span class="term-tab" data-tab="kim" data-active="true">{tm.tabs.kim}</span>
      <span class="term-tab" data-tab="boss" data-active="false">{tm.tabs.boss}</span>
    </div>
    <button class="term-replay" type="button" data-term-replay hidden>{tm.replay}</button>
  </div>
  <pre class="term-body" aria-hidden="true">{tm.lines.map((line, i) => {
    const gap = line.k === 'comment' && i > 0 ? ' tl-gap' : ''
    if (line.k === 'cmd') return <span class="tl tl-cmd" data-k="cmd" data-who={line.who}><span class={`tl-prompt tl-prompt-${line.who}`}>{prompt(line.who)}</span><span class="tl-text">{line.text}</span></span>
    return <span class={`tl tl-${line.k}${gap}`} data-k={line.k} data-who={'who' in line ? line.who : undefined}><span class="tl-text">{line.text}</span></span>
  })}</pre>
  <div class="sr-only">
    <p>{tm.transcriptTitle}</p>
    <ol>{tm.lines.map((line) => <li>{line.k === 'cmd' ? `${prompt(line.who)}${line.text}` : line.text}</li>)}</ol>
  </div>
</figure>
