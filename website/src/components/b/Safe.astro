---
// Variant B: "Shared with the whole team, safely" — three cards with small UI illustrations in plain terms (who sees
// which folder, a draft with its sources, the access log), then the limits in three lines (full promise on /security).
// Illustrations are decorative; the card text says it in words.
import Lines from '../Lines.astro'
import type { CopyB } from '../../content/en-b'
import Icon from '../Icon.astro'
interface Props { t: CopyB }
const { t } = Astro.props
const s = t.safe
---
<section class="section section-tint" id="security" aria-labelledby="safe-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{s.eyebrow}</span>
      <h2 id="safe-title"><Lines text={s.title} /></h2>
      <p>{s.sub}</p>
    </div>
    <ul class="bento bento-pillars">
      {s.items.map((it) => (
        <li class="bento-card" data-reveal>
          <div class="bento-art" aria-hidden="true">
            {it.icon === 'filter' && (
              <div class="sv-views">
                {s.views.map((v) => (
                  <div class="sv-view">
                    <span class="sv-who"><span class="sv-avatar">{v.who.slice(0, 1)}</span>{v.who}{s.viewLabel}<small>{v.team}</small></span>
                    <span class="sv-folders">{v.folders.map((f) => <span class="sv-folder"><Icon name="folder" />{f}</span>)}</span>
                  </div>
                ))}
              </div>
            )}
            {it.icon === 'draft' && (
              <div class="mini mini-draft">
                <div class="mini-file">
                  <span class="mini-file-icon"><Icon name="draft" /></span>
                  <span class="mini-file-name"><small>{s.draft.path}</small>{s.draft.file}</span>
                </div>
                <div class="mini-sources">
                  <span class="mini-label">{s.draft.sourcesLabel}</span>
                  {s.draft.sources.map((x) => <span class="mini-chip"><Icon name="folder" />{x}</span>)}
                </div>
                <p class="mini-visible"><Icon name="lock" />{s.draft.visible}</p>
                <span class="mini-move">{s.draft.move}<small>{s.draft.moveNote}</small></span>
              </div>
            )}
            {it.icon === 'log' && (
              <div class="sv-log">
                {s.log.map((r) => (
                  <div class="sv-log-row">
                    <span class="sv-t">{r.t}</span>
                    <span class="sv-who-s">{r.who}<small>{r.via}</small></span>
                    <span class="sv-file"><Icon name="eye" />{r.file}</span>
                  </div>
                ))}
                <span class="sv-anchor"><Icon name="shield" />{s.logNote}</span>
              </div>
            )}
          </div>
          <div class="bento-text">
            <span class="bento-icon"><Icon name={it.icon} /><span class="bento-label">{it.label}</span></span>
            <h3>{it.title}</h3>
            {it.body && <p>{it.body}</p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="lim" data-reveal>
      <p class="lim-title"><Icon name="eye" />{t.security.limitsTitle}</p>
      <ul>{t.security.limits.map((x) => <li>{x}</li>)}</ul>
      <a class="lim-link" href="/security">{t.security.link}<span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
