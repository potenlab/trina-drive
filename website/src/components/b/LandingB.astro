---
// Variant B of the home page (/b): the same structure as variant A (supabase.com-style), told for non-developer teams.
// B differs in the hero visual (an animated AI chat beside the company folders), the proof chips under it and the
// use-case gallery. Shared sections come from components/; B-only parts live in components/b/ and are styled by
// styles/b.css, which only this page loads.
import type { CopyB } from '../../content/en-b'
import Base from '../../layouts/Base.astro'
import { CLOUD_LIVE, LINKS, SITE_URL } from '../../site'
import CloudTrust from '../CloudTrust.astro'
import Faq from '../Faq.astro'
import FinalCta from '../FinalCta.astro'
import Footer from '../Footer.astro'
import Icon from '../Icon.astro'
import Marquee from '../Marquee.astro'
import Nav from '../Nav.astro'
import OpenSource from '../OpenSource.astro'
import Pricing from '../Pricing.astro'
import Products from '../Products.astro'
import StartCta from '../StartCta.astro'
import Steps from '../Steps.astro'
import ChatDemo from './ChatDemo.astro'
import UseCases from './UseCases.astro'
import '../../styles/b.css'

interface Props { t: CopyB }
const { t } = Astro.props
const home = '/b'
const h = t.hero
---
<Base t={t} noindex canonicalHref={`${SITE_URL}/`} preloadHero variant="b">
  <Nav t={t} home={home} />
  <main id="main" class="vb">
    <!-- hero: Trina Cloud first, self-host second; then an AI chat window answering from the company folders -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-copy">
        <a class="pill" href="#pricing"><span class="pill-dot" aria-hidden="true"></span>{h.pill}<span class="pill-arrow" aria-hidden="true">→</span></a>
        <h1 id="hero-title">{h.title} <span class="accent-text">{h.titleAccent}</span></h1>
        <p class="hero-sub">{h.sub}</p>
        <div class="hero-ctas">
          <StartCta label={h.primary} lang={t.lang} />
          <a class="btn btn-secondary btn-lg" data-cta="self-host" href={LINKS.github} rel="noopener"><Icon name="github" />{h.secondary}</a>
        </div>
        <p class="hero-note">{CLOUD_LIVE ? h.noteLive : h.note}</p>
      </div>
      <div class="container b-stage">
        <div class="stage-glow" aria-hidden="true"></div>
        <ChatDemo t={t} />
      </div>
      <div class="container b-proof-wrap">
        <ul class="proof b-proof">
          {t.proof.map((p) => <li><Icon name={p.icon} />{p.text}</li>)}
        </ul>
      </div>
    </section>

    <!-- the AI apps it works with, as an endless logo marquee (same component and list as variant A) -->
    <section class="cred mq-band" aria-label={t.clients.title}>
      <div class="container">
        <Marquee title={t.clients.title} items={t.clients.any} note={t.clients.rollout} trademarks={t.clients.trademarks} />
      </div>
    </section>

    <Products t={t} />

    <UseCases t={t} />

    <Steps t={t} />

    <!-- Trina Cloud: hosted by us, in four short facts (design commitments while in early access) -->
    <CloudTrust t={t} />

    <OpenSource t={t} tint={false} />

    <Pricing t={t} tint />

    <Faq t={t} />

    <FinalCta t={t} />
  </main>
  <Footer t={t} home={home} />
  <script>
    import '../../scripts/main'
    import '../../scripts/b'
  </script>
</Base>
