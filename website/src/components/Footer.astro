---
// Site footer: brand, a few links, copyright. The legal entity (Trina Inc., registered address, governing law) is named
// in the Terms, Privacy and Refund pages linked here.
import type { Copy } from '../content/en'
import { CONTACT_EMAIL, LINKS } from '../site'
import Logo from './Logo.astro'

interface Props { t: Copy; home: string }
const { t, home } = Astro.props
const f = t.footer
const l = f.links
const a = (id: string) => `${home}#${id}`
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href={home} aria-label="Trina Drive home"><Logo /><span>Trina Drive</span></a>
        <p class="footer-tag">{f.tagline}</p>
        <a class="footer-trust" href="/security"><span aria-hidden="true"></span>{f.trust}</a>
      </div>
      <div>
        <h2>{f.product}</h2>
        <ul>
          <li><a href={a('product')}>{l.product}</a></li>
          <li><a href={a('open-source')}>{l.openSource}</a></li>
          <li><a href={a('pricing')}>{l.pricing}</a></li>
          <li><a href={a('faq')}>{l.faq}</a></li>
        </ul>
      </div>
      <div>
        <h2>{f.resources}</h2>
        <ul>
          <li><a href={LINKS.docs} rel="noopener">{l.docs}</a></li>
          <li><a href={LINKS.github} rel="noopener">{l.github}</a></li>
          <li><a href={LINKS.installGuide} rel="noopener">{l.selfHost}</a></li>
          <li><a href="/security">{l.security}</a></li>
          <li><a href="/compare/google-drive">{l.compare}</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        </ul>
      </div>
      <div>
        <h2>{f.legal}</h2>
        <ul>
          <li><a href="/terms">{l.terms}</a></li>
          <li><a href="/privacy">{l.privacy}</a></li>
          <li><a href="/refund">{l.refund}</a></li>
        </ul>
      </div>
    </div>
    <p class="copyright">{f.copyright}</p>
  </div>
</footer>
