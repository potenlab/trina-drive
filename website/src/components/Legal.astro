---
// Terms / Privacy / Refund. The text lives in src/legal/<page>.<lang>.md (copied from
// research/trina-drive/payments/legal/ with the placeholders filled) and is rendered to HTML at build time.
// Draft — lawyer review pending. Edit the Markdown, not this file, to change the wording.
import type { Copy } from '../content/en'
import Base from '../layouts/Base.astro'
import Footer from './Footer.astro'
import Nav from './Nav.astro'
import * as termsEn from '../legal/terms.en.md'
import * as privacyEn from '../legal/privacy.en.md'
import * as refundEn from '../legal/refund.en.md'

const LEGAL_UPDATED = '2026-10-23'

interface Props { t: Copy; page: 'terms' | 'privacy' | 'refund' }
const { t, page } = Astro.props
const docs = { terms: termsEn, privacy: privacyEn, refund: refundEn }
const { Content } = docs[page]
const home = '/'
const title = t.legal[page].title
---
<Base t={t} title={`${title} — Trina Drive`} description={t.legal[page].description}>
  <Nav t={t} home={home} />
  <main id="main" class="container legal">
    <h1>{title}</h1>
    <p class="legal-updated">{t.legal.updated} <time datetime={LEGAL_UPDATED}>{LEGAL_UPDATED}</time></p>
    <article class="prose">
      <Content />
    </article>
    <a class="back" href={home}>← {t.legal.back}</a>
  </main>
  <Footer t={t} home={home} />
  <script>
    import '../scripts/main'
  </script>
</Base>
