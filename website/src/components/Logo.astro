---
// Wordmark: a folder-shaped mark with a key slot, plus "Trina Drive". Same mark as public/favicon.svg.
---
<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="30" height="30" rx="8" class="logo-bg" />
  <path d="M8 11.5a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2V21a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2z" class="logo-fold" />
  <circle cx="16" cy="16.5" r="1.9" class="logo-key" />
  <path d="M16 18v2.4" class="logo-keyline" />
</svg>
<style is:global>
  .logo-bg { fill: var(--btn); }
  .logo-fold { fill: none; stroke: var(--btn-fg); stroke-width: 1.8; stroke-linejoin: round; }
  .logo-key { fill: var(--logo-key); }
  .logo-keyline { stroke: var(--logo-key); stroke-width: 1.8; stroke-linecap: round; }
</style>
