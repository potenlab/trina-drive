---
import type { Copy } from '../content/en'
import Base from '../layouts/Base.astro'
import { LINKS, SITE_URL, CONTACT_EMAIL } from '../site'
import Benchmark from './Benchmark.astro'
import Bento from './Bento.astro'
import Compare from './Compare.astro'
import Competitors from './Competitors.astro'
import FilesMock from './FilesMock.astro'
import Flow from './Flow.astro'
import Footer from './Footer.astro'
import ClientMark from './ClientMark.astro'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import Nav from './Nav.astro'
import Pricing from './Pricing.astro'
import Terminal from './Terminal.astro'

interface Props { t: Copy; /** Served at /a: same page, noindex with canonical → / (A/B link). */ abLink?: boolean }
const { t, abLink = false } = Astro.props
const home = '/'
const h = t.hero

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#org`,
      name: 'Trina Inc.',
      url: SITE_URL,
      email: CONTACT_EMAIL,
      logo: `${SITE_URL}/apple-touch-icon.png`,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Trina Drive',
      url: new URL(home, SITE_URL).href,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'macOS, Linux',
      description: t.meta.description,
      publisher: { '@id': `${SITE_URL}/#org` },
      offers: [
        { '@type': 'Offer', name: 'Community (self-hosted)', price: '0', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Team (managed)', price: '99', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Business (managed)', price: '349', priceCurrency: 'USD' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
    },
  ],
}
---
<Base t={t} jsonLd={abLink ? undefined : jsonLd} preloadHero variant="a" noindex={abLink} canonicalHref={abLink ? `${SITE_URL}/` : undefined}>
  <Nav t={t} home={home} />
  <main id="main">
    <!-- hero: copy centred over the key visual, then the product stage (Files view + the Alex/Sam terminal) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-copy">
        <a class="pill" href={LINKS.github} rel="noopener"><span class="pill-dot" aria-hidden="true"></span>{h.pill}<span class="pill-arrow" aria-hidden="true">→</span></a>
        <h1 id="hero-title">{h.title} <span class="accent-text">{h.titleAccent}</span></h1>
        <p class="hero-sub">{h.sub}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" data-cta="see-how" href="#how">{h.primary}<Icon name="arrow" /></a>
          <a class="btn btn-secondary btn-lg" data-cta="book-call" href={LINKS.bookCall(t.lang)}>{h.secondary}</a>
        </div>
        <div class="hero-meta">
          <div class="install">
            <code><span class="prompt" aria-hidden="true">$ </span>{h.install}</code>
            <button class="copy-btn" type="button" data-copy={h.install} data-copied={h.copied}>{h.copy}</button>
          </div>
          <a class="hero-gh" href={LINKS.github} rel="noopener"><Icon name="github" />{h.github}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="container hero-stage">
        <div class="stage-glow" aria-hidden="true"></div>
        <div class="stage-files"><FilesMock t={t} /></div>
        <div class="stage-term"><Terminal t={t} /></div>
      </div>
    </section>

    <!-- credibility: supported clients (official logo where the brand allows it, name always as text) + three plain facts -->
    <section class="cred" aria-label={t.clients.title}>
      <div class="container">
        <p class="cred-title">{t.clients.title}</p>
        <ul class="marks">
          {t.clients.items.map((c) => (
            <li class="mark" data-status={c.status}><ClientMark name={c.name} /><span class="mark-text">{c.name}<small>{c.status === 'today' ? t.clients.today : t.clients.soon}</small></span></li>
          ))}
        </ul>
        <p class="marks-note">{t.clients.trademarks}</p>
        <ul class="proof">
          {t.proof.map((p) => <li><Icon name={p.icon} />{p.text}</li>)}
        </ul>
      </div>
    </section>

    <!-- one compact comparison: ontology/RAG vs. a drive connector vs. Trina Drive, with the one-search demo -->
    <Compare c={t.compare}>
      <pre class="cmp-term">{t.compare.demo.map((l, i) => <span class={i === 0 ? 'cmp-cmd' : ''}>{l}</span>)}</pre>
    </Compare>

    {t.benchmark.enabled && <Benchmark t={t} />}

    <!-- what you get -->
    <section class="section" id="features" aria-labelledby="features-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.features.eyebrow}</span>
          <h2 id="features-title">{t.features.title}</h2>
        </div>
        <Bento t={t} items={t.features.items} />
      </div>
    </section>

    <!-- safe to share: three pillars with their command, then the limits in three lines (full promise on /security) -->
    <section class="section section-tint" id="security" aria-labelledby="pillars-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.pillars.eyebrow}</span>
          <h2 id="pillars-title">{t.pillars.title}</h2>
        </div>
        <Bento t={t} items={t.pillars.items} variant="pillars" />
        <div class="lim" data-reveal>
          <p class="lim-title"><Icon name="eye" />{t.security.limitsTitle}</p>
          <ul>{t.security.limits.map((s) => <li>{s}</li>)}</ul>
          <a class="lim-link" href="/security">{t.security.link}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- how it works -->
    <section class="section" id="how" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.how.eyebrow}</span>
          <h2 id="how-title">{t.how.title}</h2>
        </div>
        <ol class="steps">
          {t.how.steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step-num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              {s.code && <pre><span class="tl-prompt" aria-hidden="true">$ </span>{s.code}</pre>}
            </li>
          ))}
        </ol>
        <Flow t={t} />
      </div>
    </section>

    {t.competitors.enabled && <Competitors t={t} />}

    <Pricing t={t} />

    <!-- faq -->
    <section class="section section-tint" id="faq" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="faq-side">
          <div class="section-head">
            <span class="eyebrow">{t.faq.eyebrow}</span>
            <h2 id="faq-title">{t.faq.title}</h2>
          </div>
          <div class="faq-more">
            <p class="faq-more-title">{t.faq.more}</p>
            <p>{t.faq.moreBody}</p>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </div>
        </div>
        <div class="faq">
          {t.faq.items.map((i) => (
            <details>
              <summary>{i.q}<Icon name="plus" /></summary>
              <p class="answer">{i.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- final cta -->
    <section class="section section-cta" id="start" aria-labelledby="start-title">
      <div class="container">
        <div class="cta-box" data-reveal>
          <div class="cta-bg" aria-hidden="true"></div>
          <span class="cta-logo" aria-hidden="true"><Logo /></span>
          <h2 id="start-title">{t.cta.title}</h2>
          <p>{t.cta.sub}</p>
          <div class="hero-ctas">
            <a class="btn btn-primary btn-lg" href={LINKS.github} rel="noopener"><Icon name="github" />{t.cta.primary}</a>
            <a class="btn btn-secondary btn-lg" data-cta="book-call" href={LINKS.bookCall(t.lang)}>{t.cta.secondary}</a>
          </div>
          <div class="install install-dark">
            <code><span class="prompt" aria-hidden="true">$ </span>{h.install}</code>
            <button class="copy-btn" type="button" data-copy={h.install} data-copied={h.copied}>{h.copy}</button>
          </div>
          <p class="cta-install"><a href={LINKS.installGuide} rel="noopener">{t.cta.install} →</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} home={home} />
  <script>
    import '../scripts/main'
  </script>
</Base>
