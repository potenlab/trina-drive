---
import type { Copy } from '../content/en'
import Base from '../layouts/Base.astro'
import { LINKS, SITE_URL, CONTACT_EMAIL } from '../site'
import Benchmark from './Benchmark.astro'
import Bento from './Bento.astro'
import Competitors from './Competitors.astro'
import FilesMock from './FilesMock.astro'
import Flow from './Flow.astro'
import Footer from './Footer.astro'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import Nav from './Nav.astro'
import Pricing from './Pricing.astro'
import Terminal from './Terminal.astro'

interface Props { t: Copy }
const { t } = Astro.props
const home = '/'
const h = t.hero

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#org`,
      name: 'Trina Inc.',
      url: SITE_URL,
      email: CONTACT_EMAIL,
      logo: `${SITE_URL}/apple-touch-icon.png`,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Trina Drive',
      url: new URL(home, SITE_URL).href,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'macOS, Linux',
      description: t.meta.description,
      publisher: { '@id': `${SITE_URL}/#org` },
      offers: [
        { '@type': 'Offer', name: 'Community (self-hosted)', price: '0', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Team (managed)', price: '99', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Business (managed)', price: '349', priceCurrency: 'USD' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
    },
  ],
}
---
<Base t={t} jsonLd={jsonLd} preloadHero>
  <Nav t={t} home={home} />
  <main id="main">
    <!-- hero: copy centred over the key visual, then the product stage (Files view + the Alex/Sam terminal) -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-copy">
        <a class="pill" href="#faq"><span class="pill-dot" aria-hidden="true"></span>{h.pill}<span class="pill-arrow" aria-hidden="true">→</span></a>
        <h1 id="hero-title">{h.title} <span class="accent-text">{h.titleAccent}</span></h1>
        <p class="hero-sub">{h.sub}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href="#how">{h.primary}<Icon name="arrow" /></a>
          <a class="btn btn-secondary btn-lg" href={LINKS.bookCall(t.lang)}>{h.secondary}</a>
        </div>
        <div class="install">
          <code><span class="prompt" aria-hidden="true">$ </span>{h.install}</code>
          <button class="copy-btn" type="button" data-copy={h.install} data-copied={h.copied}>{h.copy}</button>
        </div>
      </div>
      <div class="container hero-stage">
        <div class="stage-glow" aria-hidden="true"></div>
        <div class="stage-files"><FilesMock t={t} /></div>
        <div class="stage-term"><Terminal t={t} /></div>
      </div>
    </section>

    <!-- credibility: supported clients as text marks + three plain facts -->
    <section class="cred" aria-label={t.clients.title}>
      <div class="container">
        <p class="cred-title">{t.clients.title}</p>
        <ul class="marks">
          {t.clients.items.map((c) => (
            <li class="mark" data-status={c.status}>{c.name}<small>{c.status === 'today' ? t.clients.today : t.clients.soon}</small></li>
          ))}
        </ul>
        <ul class="proof">
          {t.proof.map((p) => <li><Icon name={p.icon} />{p.text}</li>)}
        </ul>
      </div>
    </section>

    <!-- knowledge base without the build: the enterprise way vs the small-team way -->
    <section class="section" id="kb" aria-labelledby="kb-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.kb.eyebrow}</span>
          <h2 id="kb-title">{t.kb.title}</h2>
          <p>{t.kb.sub}</p>
        </div>
        <div class="ways">
          {t.kb.cols.map((c) => (
            <div class={`way${c.us ? ' way-us' : ''}`} data-reveal>
              <p class="way-tag">{c.tag}</p>
              <h3>{c.name}</h3>
              <ul>{c.points.map((pt) => <li><Icon name={c.us ? 'check' : 'minus'} />{pt}</li>)}</ul>
              <p class="way-foot">{c.foot}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- vs a drive connector -->
    <section class="section section-tint" id="connector" aria-labelledby="gd-title">
      <div class="container gd-grid">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.gdrive.eyebrow}</span>
          <h2 id="gd-title">{t.gdrive.title}</h2>
          <p>{t.gdrive.sub}</p>
        </div>
        <div class="gd-cards" data-reveal>
          <div class="gd-card">
            <h3>{t.gdrive.left.name}</h3>
            <ul>{t.gdrive.left.points.map((pt) => <li><Icon name="minus" />{pt}</li>)}</ul>
          </div>
          <div class="gd-card gd-us">
            <h3>{t.gdrive.right.name}</h3>
            <ul>{t.gdrive.right.points.map((pt) => <li><Icon name="check" />{pt}</li>)}</ul>
            <pre class="gd-demo" aria-hidden="true">{t.gdrive.demo.map((l, i) => <span class={i === 0 ? 'gd-cmd' : ''}>{l}</span>)}</pre>
          </div>
        </div>
      </div>
    </section>

    {t.benchmark.enabled && <Benchmark t={t} />}

    <!-- what you get -->
    <section class="section" id="features" aria-labelledby="features-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.features.eyebrow}</span>
          <h2 id="features-title">{t.features.title}</h2>
        </div>
        <Bento t={t} items={t.features.items} />
      </div>
    </section>

    <!-- shared with the whole team, safely -->
    <section class="section section-tint" id="safe" aria-labelledby="pillars-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.pillars.eyebrow}</span>
          <h2 id="pillars-title">{t.pillars.title}</h2>
        </div>
        <Bento t={t} items={t.pillars.items} variant="pillars" />
      </div>
    </section>

    <!-- security: always-dark panel -->
    <section class="section" id="security" aria-labelledby="security-title">
      <div class="container">
        <div class="sec-panel">
          <div class="sec-visual" aria-hidden="true">
            <picture>
              <source type="image/avif" srcset="/img/vault-560.avif 560w, /img/vault-1120.avif 1120w" sizes="(max-width: 900px) 90vw, 520px" />
              <img src="/img/vault-560.webp" srcset="/img/vault-560.webp 560w, /img/vault-1120.webp 1120w" sizes="(max-width: 900px) 90vw, 520px" alt="" width="1120" height="836" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="sec-top">
            <div class="section-head" data-reveal>
              <span class="eyebrow">{t.security.eyebrow}</span>
              <h2 id="security-title">{t.security.title}</h2>
            </div>
            <figure class="promise" data-reveal>
              <figcaption class="promise-label">{t.security.promiseLabel}</figcaption>
              <blockquote>{t.security.promise.map((s) => <p>{s}</p>)}</blockquote>
            </figure>
          </div>
          <div class="sec-lists">
            <div class="sec-list ok" data-reveal>
              <h3><Icon name="shield" />{t.security.protectTitle}</h3>
              <ul>{t.security.protect.map((s) => <li><Icon name="check" />{s}</li>)}</ul>
            </div>
            <div class="sec-list no" data-reveal>
              <h3><Icon name="eye" />{t.security.limitsTitle}</h3>
              <ul>{t.security.limits.map((s) => <li><Icon name="minus" />{s}</li>)}</ul>
            </div>
          </div>
          <a class="sec-link" href="/security">{t.security.link}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- how it works -->
    <section class="section" id="how" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{t.how.eyebrow}</span>
          <h2 id="how-title">{t.how.title}</h2>
        </div>
        <ol class="steps">
          {t.how.steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step-num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              {s.code && <pre><span class="tl-prompt" aria-hidden="true">$ </span>{s.code}</pre>}
            </li>
          ))}
        </ol>
        <Flow t={t} />
      </div>
    </section>

    {t.competitors.enabled && <Competitors t={t} />}

    <Pricing t={t} />

    <!-- faq -->
    <section class="section section-tint" id="faq" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="faq-side">
          <div class="section-head">
            <span class="eyebrow">{t.faq.eyebrow}</span>
            <h2 id="faq-title">{t.faq.title}</h2>
          </div>
          <div class="faq-more">
            <p class="faq-more-title">{t.faq.more}</p>
            <p>{t.faq.moreBody}</p>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </div>
        </div>
        <div class="faq">
          {t.faq.items.map((i) => (
            <details>
              <summary>{i.q}<Icon name="plus" /></summary>
              <p class="answer">{i.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- final cta -->
    <section class="section section-cta" id="start" aria-labelledby="start-title">
      <div class="container">
        <div class="cta-box" data-reveal>
          <div class="cta-bg" aria-hidden="true"></div>
          <span class="cta-logo" aria-hidden="true"><Logo /></span>
          <h2 id="start-title">{t.cta.title}</h2>
          <p>{t.cta.sub}</p>
          <div class="hero-ctas">
            <a class="btn btn-primary btn-lg" href={LINKS.github} rel="noopener"><Icon name="github" />{t.cta.primary}</a>
            <a class="btn btn-secondary btn-lg" href={LINKS.bookCall(t.lang)}>{t.cta.secondary}</a>
          </div>
          <div class="install install-dark">
            <code><span class="prompt" aria-hidden="true">$ </span>{h.install}</code>
            <button class="copy-btn" type="button" data-copy={h.install} data-copied={h.copied}>{h.copy}</button>
          </div>
          <p class="cta-install"><a href={LINKS.installGuide} rel="noopener">{t.cta.install} →</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer t={t} home={home} />
  <script>
    import '../scripts/main'
  </script>
</Base>
