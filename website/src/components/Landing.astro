---
// Home page, variant A (/ and /a). Structure after supabase.com: hero (Trina Cloud first, self-host second) → the AI
// apps it works with → product grid → how it works → Trina Cloud → open source → pricing → FAQ → final CTA.
import type { Copy } from '../content/en'
import Base from '../layouts/Base.astro'
import { CLOUD_LIVE, LINKS, SITE_URL } from '../site'
import { homeJsonLd } from '../seo'
import Benchmark from './Benchmark.astro'
import ChatCard from './ChatCard.astro'
import CloudTrust from './CloudTrust.astro'
import Competitors from './Competitors.astro'
import Faq from './Faq.astro'
import FilesMock from './FilesMock.astro'
import FinalCta from './FinalCta.astro'
import Footer from './Footer.astro'
import Icon from './Icon.astro'
import Marquee from './Marquee.astro'
import Nav from './Nav.astro'
import OpenSource from './OpenSource.astro'
import Pricing from './Pricing.astro'
import Products from './Products.astro'
import StartCta from './StartCta.astro'
import Steps from './Steps.astro'

interface Props { t: Copy; /** Served at /a: same page, noindex with canonical → / (A/B link). */ abLink?: boolean }
const { t, abLink = false } = Astro.props
const home = '/'
const h = t.hero

// Organization, WebSite, SoftwareApplication (one offer per price shown), source code and the FAQ, built from t.
const jsonLd = homeJsonLd(t)
---
<Base t={t} jsonLd={abLink ? undefined : jsonLd} preloadHero variant="a" noindex={abLink} canonicalHref={abLink ? `${SITE_URL}/` : undefined}>
  <Nav t={t} home={home} />
  <main id="main">
    <!-- hero: Trina Cloud first, self-host second; then the drive (Files view) and an AI app answering from it -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-copy">
        <a class="pill" href="#pricing"><span class="pill-dot" aria-hidden="true"></span>{h.pill}<span class="pill-arrow" aria-hidden="true">→</span></a>
        <h1 id="hero-title">{h.title} <span class="accent-text">{h.titleAccent}</span></h1>
        <p class="hero-sub">{h.sub}</p>
        <div class="hero-ctas">
          <StartCta label={h.primary} lang={t.lang} />
          <a class="btn btn-secondary btn-lg" data-cta="self-host" href={LINKS.github} rel="noopener"><Icon name="github" />{h.secondary}</a>
        </div>
        <p class="hero-note">{CLOUD_LIVE ? h.noteLive : h.note}</p>
      </div>
      <div class="container hero-stage">
        <div class="stage-glow" aria-hidden="true"></div>
        <div class="stage-files"><FilesMock t={t} /></div>
        <div class="stage-chat"><ChatCard t={t} /></div>
      </div>
    </section>

    <!-- the AI apps it works with, as an endless logo marquee (official logo where the brand allows it, name always as text) -->
    <section class="cred" aria-label={t.clients.title}>
      <div class="container">
        <Marquee title={t.clients.title} items={t.clients.any} note={t.clients.rollout} trademarks={t.clients.trademarks} />
      </div>
    </section>

    <Products t={t} tint />

    {t.benchmark.enabled && <Benchmark t={t} />}

    <Steps t={t} />

    <!-- Trina Cloud: hosted by us, in four short facts (design commitments while in early access) -->
    <CloudTrust t={t} />

    <OpenSource t={t} tint={false} />

    {t.competitors.enabled && <Competitors t={t} />}

    <Pricing t={t} tint />

    <Faq t={t} />

    <FinalCta t={t} />
  </main>
  <Footer t={t} home={home} />
  <script>
    import '../scripts/main'
  </script>
</Base>
