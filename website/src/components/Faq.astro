---
// FAQ (both variants). Copy: t.faq.
import Lines from './Lines.astro'
import type { Copy } from '../content/en'
import { CONTACT_EMAIL } from '../site'
import Icon from './Icon.astro'
interface Props { t: Pick<Copy, 'faq'>; tint?: boolean }
const { t, tint = false } = Astro.props
const f = t.faq
---
<section class={`section${tint ? ' section-tint' : ''}`} id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-side">
      <div class="section-head">
        <span class="eyebrow">{f.eyebrow}</span>
        <h2 id="faq-title"><Lines text={f.title} /></h2>
      </div>
      <div class="faq-more">
        <p class="faq-more-title">{f.more}</p>
        <p>{f.moreBody}</p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
    </div>
    <div class="faq">
      {f.items.map((i) => (
        <details>
          <summary>{i.q}<Icon name="plus" /></summary>
          <p class="answer">{i.a}{i.link && <> <a href={i.link.href} rel="noopener">{i.link.text}</a></>}</p>
        </details>
      ))}
    </div>
  </div>
</section>
