# drive.trina.app — environment variables. Copy to .env for local builds; on Vercel set them under
# Project → Settings → Environment Variables (Preview = sandbox values, Production = live values).
# Never commit real values. Nothing here is required: with no variables the site builds and every price button
# opens an email to contact@trina.app, as before.

# ---------------------------------------------------------------------------------------------------------------
# Build time (PUBLIC_*): inlined into the static site by `bun run build`. Public by design — a Paddle client-side
# token and price IDs only. Never put a Paddle API key (pdl_..._apikey_...) in a PUBLIC_ variable.
# Changing any of them needs a rebuild/redeploy.
# ---------------------------------------------------------------------------------------------------------------

# Paddle → Developer tools → Authentication → Client-side tokens. test_... for sandbox, live_... for production.
# Without a valid token (or with a token that does not match PUBLIC_PADDLE_ENV) Paddle stays off → mailto.
PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox | production
PUBLIC_PADDLE_ENV=sandbox

# Paddle → Catalog → Products → price IDs (pri_...). Sandbox and live IDs differ.
# A missing ID only turns that one plan/cycle back into the email flow.
PUBLIC_PADDLE_PRICE_TEAM_MONTHLY=          # $99 / month (14-day trial set on the price in Paddle)
PUBLIC_PADDLE_PRICE_TEAM_YEARLY=           # $990 / year
PUBLIC_PADDLE_PRICE_BUSINESS_MONTHLY=      # $349 / month
PUBLIC_PADDLE_PRICE_BUSINESS_YEARLY=       # $3,490 / year
# Extra AI-connected people beyond the included 10 (Team) / 40 (Business), added as a quantity in the same checkout.
# Paddle needs every item in one checkout on the same billing cycle, so monthly and yearly seats are separate prices.
PUBLIC_PADDLE_PRICE_EXTRA_SEAT_TEAM=       # $9 / month
PUBLIC_PADDLE_PRICE_EXTRA_SEAT_BUSINESS=   # $7 / month
PUBLIC_PADDLE_PRICE_EXTRA_SEAT_TEAM_YEARLY=      # $90 / year   (optional; without it, yearly + extra seats → email)
PUBLIC_PADDLE_PRICE_EXTRA_SEAT_BUSINESS_YEARLY=  # $70 / year   (optional; without it, yearly + extra seats → email)
# No PUBLIC_PADDLE_PRICE_SETUP on purpose: setup & migration is a human service sold by quote (bank transfer /
# our own invoice), not through Paddle — see research/trina-drive/payments/README.md §1–2.

# ---------------------------------------------------------------------------------------------------------------
# Runtime (server only): read by api/paddle-webhook.js on Vercel. Not exposed to the browser.
# ---------------------------------------------------------------------------------------------------------------

# sandbox | live (production also accepted). Picks the IP allowlist, dashboard link and storage key prefix.
PADDLE_ENV=sandbox
# Paddle → Developer tools → Notifications → the destination's secret key (pdl_ntfset_...). Required: without it
# every webhook is rejected with 401.
PADDLE_WEBHOOK_SECRET=
# Allowed clock difference for the Paddle-Signature timestamp, seconds (Paddle SDK default 5).
PADDLE_WEBHOOK_TOLERANCE_SEC=5
# 1 = accept webhooks only from Paddle's published IPs (sandbox/live lists in api/_lib/paddle-webhook-core.js).
# Turn off Vercel bot protection / firewall challenges for /api/paddle-webhook when using it.
PADDLE_CHECK_IP=1

# Optional storage (Upstash Redis REST; added automatically by Vercel Marketplace "Upstash for Redis").
# Enables de-duplication by event_id and the latest state per subscription. One pair or the other.
# If you enable it, add the provider to the privacy policy's processor table (src/legal/privacy.*.md §5) first.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional email alerts (Resend) for subscription.created / canceled / past_due and transaction.payment_failed.
# The sender domain (trina.app) must be verified with the provider.
RESEND_API_KEY=
NOTIFY_FROM=Trina Drive Billing <billing@trina.app>
NOTIFY_EMAIL=contact@trina.app

# Without storage and email, every handled event is still written to the Vercel function log as one JSON line
# ({"msg":"paddle_webhook", event_id, event_type, subscription_id, status, items, total, ...}).
